<Fluent:RibbonWindow
    x:Class="VirtualFolders.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Fluent="urn:fluent-ribbon"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:VirtualFolders"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:VirtualFolders.Ui"
    Title="Virtual Folders"
    Width="1280"
    Height="720"
    AllowDrop="True"
    DragEnter="RibbonWindow_DragEnter"
    DragOver="RibbonWindow_DragOver"
    Drop="RibbonWindow_Drop"
    Loaded="RibbonWindow_Loaded"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Fluent:Ribbon Grid.Row="0">

            <!--  Menu  -->
            <Fluent:Ribbon.Menu>
                <Fluent:Backstage Header="File">
                    <Fluent:BackstageTabControl>
                        <Fluent:BackstageTabItem Header="Files">
                            <WrapPanel Margin="8">
                                <Fluent:Button
                                    Width="200"
                                    Margin="4"
                                    Command="{Binding NewCommand}"
                                    Header="New..."
                                    Style="{StaticResource Fluent.Ribbon.Styles.Backstage.Button}">
                                    <Fluent:Button.Icon>
                                        <Canvas
                                            Width="24"
                                            Height="24">
                                            <Path
                                                Data="M23 18H20V15H18V18H15V20H18V23H20V20H23M6 2C4.89 2 4 2.9 4 4V20C4 21.11 4.89 22 6 22H13.81C13.45 21.38 13.2 20.7 13.08 20H6V4H13V9H18V13.08C18.33 13.03 18.67 13 19 13C19.34 13 19.67 13.03 20 13.08V8L14 2M8 12V14H16V12M8 16V18H13V16Z"
                                                Fill="#10893e" />
                                        </Canvas>
                                    </Fluent:Button.Icon>
                                </Fluent:Button>
                                <Fluent:Button
                                    Width="200"
                                    Margin="4"
                                    Command="{Binding OpenCommand}"
                                    Header="Open..."
                                    Style="{StaticResource Fluent.Ribbon.Styles.Backstage.Button}">
                                    <Fluent:Button.Icon>
                                        <Canvas
                                            Width="24"
                                            Height="24">
                                            <Path
                                                Data="M6.1,10L4,18V8H21A2,2 0 0,0 19,6H12L10,4H4A2,2 0 0,0 2,6V18A2,2 0 0,0 4,20H19C19.9,20 20.7,19.4 20.9,18.5L23.2,10H6.1M19,18H6L7.6,12H20.6L19,18Z"
                                                Fill="#0063b1" />
                                        </Canvas>
                                    </Fluent:Button.Icon>
                                </Fluent:Button>
                                <Fluent:Button
                                    Width="200"
                                    Margin="4"
                                    Command="{Binding CloseAllCommand}"
                                    Header="Close all"
                                    Style="{StaticResource Fluent.Ribbon.Styles.Backstage.Button}">
                                    <Fluent:Button.Icon>
                                        <Canvas
                                            Width="24"
                                            Height="24">
                                            <Path
                                                Data="M4 20H18V22H4C2.9 22 2 21.11 2 20V6H4V20M20.22 2H7.78C6.8 2 6 2.8 6 3.78V16.22C6 17.2 6.8 18 7.78 18H20.22C21.2 18 22 17.2 22 16.22V3.78C22 2.8 21.2 2 20.22 2M19 13.6L17.6 15L14 11.4L10.4 15L9 13.6L12.6 10L9 6.4L10.4 5L14 8.6L17.6 5L19 6.4L15.4 10L19 13.6Z"
                                                Fill="#881798" />
                                        </Canvas>
                                    </Fluent:Button.Icon>
                                </Fluent:Button>
                            </WrapPanel>
                        </Fluent:BackstageTabItem>
                        <Fluent:BackstageTabItem
                            DataContext="{Binding Settings}"
                            Header="Settings">
                            <StackPanel Margin="8">
                                <Expander
                                    Header="Programs"
                                    IsExpanded="True">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition />
                                            <RowDefinition />
                                        </Grid.RowDefinitions>
                                        <ListBox
                                            Grid.Row="0"
                                            Grid.ColumnSpan="3"
                                            Height="200"
                                            ItemsSource="{Binding Programs}"
                                            SelectedItem="{Binding SelectedProgram}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <TextBlock
                                                            Margin="2"
                                                            FontSize="14"
                                                            Text="{Binding DisplayName}" />
                                                        <TextBlock
                                                            Margin="14,0"
                                                            Text="{Binding ProgramPath}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <Fluent:Button
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Width="200"
                                            Margin="4"
                                            Command="{Binding AddProgramCommand}"
                                            Header="Add..." />
                                        <Fluent:Button
                                            Grid.Row="1"
                                            Grid.Column="2"
                                            Width="200"
                                            Margin="4"
                                            Command="{Binding RemoveProgramCommand}"
                                            Header="Remove selected" />
                                    </Grid>
                                </Expander>
                            </StackPanel>
                        </Fluent:BackstageTabItem>
                    </Fluent:BackstageTabControl>
                </Fluent:Backstage>
            </Fluent:Ribbon.Menu>

            <!--  Tabs  -->
            <Fluent:RibbonTabItem Header="Folder">
                <Fluent:RibbonGroupBox Header="Add">
                    <Fluent:Button
                        Command="{Binding AddFilesCommand}"
                        Header="Files...">
                        <Fluent:Button.LargeIcon>
                            <Canvas
                                Width="24"
                                Height="24">
                                <Path
                                    Data="M13.81 22H6C4.89 22 4 21.11 4 20V4C4 2.9 4.89 2 6 2H14L20 8V13.09C19.67 13.04 19.34 13 19 13S18.33 13.04 18 13.09V9H13V4H6V20H13.09C13.21 20.72 13.46 21.39 13.81 22M23 18H20V15H18V18H15V20H18V23H20V20H23V18Z"
                                    Fill="#ff8c00" />
                            </Canvas>
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                    <Fluent:Button
                        Command="{Binding AddFolderCommand}"
                        Header="From folder...">
                        <Fluent:Button.LargeIcon>
                            <Canvas
                                Width="24"
                                Height="24">
                                <Path
                                    Data="M13 19C13 19.34 13.04 19.67 13.09 20H4C2.9 20 2 19.11 2 18V6C2 4.89 2.89 4 4 4H10L12 6H20C21.1 6 22 6.89 22 8V13.81C21.39 13.46 20.72 13.22 20 13.09V8H4V18H13.09C13.04 18.33 13 18.66 13 19M20 18V15H18V18H15V20H18V23H20V20H23V18H20Z"
                                    Fill="#ffb900" />
                            </Canvas>
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                </Fluent:RibbonGroupBox>
                <Fluent:RibbonGroupBox Header="Remove">
                    <Fluent:Button
                        Command="{Binding RemoveSelectedCommand}"
                        Header="Selected...">
                        <Fluent:Button.LargeIcon>
                            <Canvas
                                Width="24"
                                Height="24">
                                <Path
                                    Data="M13.81 22H6C4.89 22 4 21.11 4 20V4C4 2.9 4.89 2 6 2H14L20 8V13.09C19.67 13.04 19.34 13 19 13S18.33 13.04 18 13.09V9H13V4H6V20H13.09C13.21 20.72 13.46 21.39 13.81 22M22.54 21.12L20.41 19L22.54 16.88L21.12 15.47L19 17.59L16.88 15.47L15.47 16.88L17.59 19L15.47 21.12L16.88 22.54L19 20.41L21.12 22.54L22.54 21.12Z"
                                    Fill="#d13438" />
                            </Canvas>
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                    <Fluent:Button
                        Command="{Binding RemoveNotExistingCommand}"
                        Header="Not existing...">
                        <Fluent:Button.LargeIcon>
                            <Canvas
                                Width="24"
                                Height="24">
                                <Path
                                    Data="M4 19V7H16V19C16 20.1 15.1 21 14 21H6C4.9 21 4 20.1 4 19M6 9V19H14V9H6M13.5 4H17V6H3V4H6.5L7.5 3H12.5L13.5 4M19 17V15H21V17H19M19 13V7H21V13H19Z"
                                    Fill="#e74856" />
                            </Canvas>
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                    <Fluent:Button
                        Command="{Binding RemoveAllCommand}"
                        Header="All...">
                        <Fluent:Button.LargeIcon>
                            <Canvas
                                Width="24"
                                Height="24">
                                <Path
                                    Data="M14 10H3V12H14V10M14 6H3V8H14V6M3 16H10V14H3V16M14.4 22L17 19.4L19.6 22L21 20.6L18.4 18L21 15.4L19.6 14L17 16.6L14.4 14L13 15.4L15.6 18L13 20.6L14.4 22Z"
                                    Fill="#e81123" />
                            </Canvas>
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                </Fluent:RibbonGroupBox>
                <Fluent:RibbonGroupBox Header="Export">
                    <Fluent:Button
                        Command="{Binding ExportToFolderCommand}"
                        Header="Copy to folder...">
                        <Fluent:Button.LargeIcon>
                            <Canvas
                                Width="24"
                                Height="24">
                                <Path
                                    Data="M19,21H8V7H19M19,5H8A2,2 0 0,0 6,7V21A2,2 0 0,0 8,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M16,1H4A2,2 0 0,0 2,3V17H4V3H16V1Z"
                                    Fill="#8e8cd8" />
                            </Canvas>
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                    <Fluent:Button
                        Command="{Binding ExportZipCommand}"
                        Header="Create .zip...">
                        <Fluent:Button.LargeIcon>
                            <Canvas
                                Width="24"
                                Height="24">
                                <Path
                                    Data="M20 6H12L10 4H4C2.9 4 2 4.9 2 6V18C2 19.1 2.9 20 4 20H20C21.1 20 22 19.1 22 18V8C22 6.9 21.1 6 20 6M20 18H16V16H14V18H4V8H14V10H16V8H20V18M16 12V10H18V12H16M14 12H16V14H14V12M18 16H16V14H18V16Z"
                                    Fill="#6b69d6" />
                            </Canvas>
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                    <Fluent:DropDownButton Header="Playlist">
                        <Fluent:DropDownButton.Icon>
                            <Canvas
                                Width="24"
                                Height="24">
                                <Path
                                    Data="M23 19L20 16V18H16V20H20V22L23 19M13.8 22H6C4.9 22 4 21.1 4 20V4C4 2.9 4.9 2 6 2H14L20 8V13.1C19.7 13 19.3 13 19 13S18.3 13 18 13.1V9H13V4H6V20H13.1C13.2 20.7 13.5 21.4 13.8 22M8 12H16V13.8C15.9 13.9 15.8 13.9 15.7 14H8V12M8 16H13V18H8V16Z"
                                    Fill="#000000" />
                            </Canvas>
                        </Fluent:DropDownButton.Icon>
                        <Fluent:MenuItem
                            Command="{Binding ExportM3uCommand}"
                            Header="M3U..">
                            <Fluent:MenuItem.Icon>
                                <TextBlock Text="M" />
                            </Fluent:MenuItem.Icon>
                        </Fluent:MenuItem>
                        <Fluent:MenuItem
                            Command="{Binding ExportPlsCommand}"
                            Header="PLS..">
                            <Fluent:MenuItem.Icon>
                                <TextBlock Text="P" />
                            </Fluent:MenuItem.Icon>
                        </Fluent:MenuItem>
                    </Fluent:DropDownButton>
                </Fluent:RibbonGroupBox>
            </Fluent:RibbonTabItem>
        </Fluent:Ribbon>

        <!--  Main Content Area  -->
        <TabControl
            Grid.Row="1"
            ItemsSource="{Binding Folders}"
            SelectedItem="{Binding ActualFolder}"
            Tag="{Binding}">
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            Text="{Binding Name}" />
                        <Button
                            Width="20"
                            Margin="4,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=TabControl}, Path=DataContext.CloseActualFolderCommand}"
                            Content="❌"
                            Foreground="Red" />
                    </StackPanel>
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DataGrid
                            x:Name="DataGrid"
                            Grid.Row="0"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            CanUserReorderColumns="True"
                            CanUserResizeColumns="True"
                            CanUserSortColumns="True"
                            IsReadOnly="True"
                            ItemsSource="{Binding Files}"
                            SelectedItem="{Binding SelectedFile}">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem
                                        Command="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=TabControl}, Path=Tag.OpenSelectedCommand}"
                                        Header="Open" />
                                    <MenuItem Header="Open With" />
                                    <Separator />
                                    <MenuItem
                                        Command="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=TabControl}, Path=Tag.CopySelectedPathCommand}"
                                        Header="Copy path to clipboard" />
                                    <Separator />
                                    <MenuItem
                                        Command="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=TabControl}, Path=Tag.RemoveSelectedCommand}"
                                        Header="Remove" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn
                                    Width="*"
                                    MinWidth="100"
                                    CanUserSort="True"
                                    Header="Name"
                                    IsReadOnly="True"
                                    SortMemberPath="Name">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                FontSize="{Binding ElementName=ZoomSlider, Path=Value}"
                                                Text="{Binding Name}"
                                                TextDecorations="{Binding IsAvailable, Converter={ui:IsAvailableConverter}}"
                                                ToolTip="{Binding FullPath}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger
                                                                Binding="{Binding IsAvailable}"
                                                                Value="False">
                                                                <Setter Property="Foreground" Value="PaleVioletRed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn
                                    Width="Auto"
                                    MinWidth="100"
                                    CanUserSort="True"
                                    Header="Extension"
                                    IsReadOnly="True"
                                    SortMemberPath="Extension">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                FontSize="{Binding ElementName=ZoomSlider, Path=Value}"
                                                Text="{Binding Extension}"
                                                TextAlignment="Center"
                                                TextDecorations="{Binding IsAvailable, Converter={ui:IsAvailableConverter}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger
                                                                Binding="{Binding IsAvailable}"
                                                                Value="False">
                                                                <Setter Property="Foreground" Value="PaleVioletRed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn
                                    Width="Auto"
                                    MinWidth="100"
                                    CanUserSort="True"
                                    Header="Size"
                                    IsReadOnly="True"
                                    SortMemberPath="FileSize">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                FontSize="{Binding ElementName=ZoomSlider, Path=Value}"
                                                Text="{Binding FileSize}"
                                                TextAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger
                                                                Binding="{Binding IsAvailable}"
                                                                Value="False">
                                                                <Setter Property="Foreground" Value="PaleVioletRed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn
                                    Width="Auto"
                                    MinWidth="100"
                                    CanUserSort="True"
                                    Header="Attributes"
                                    IsReadOnly="True"
                                    SortMemberPath="Attributes">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                FontSize="{Binding ElementName=ZoomSlider, Path=Value}"
                                                Text="{Binding Attributes, Converter={ui:AttributesTextConverter}}"
                                                TextAlignment="Center"
                                                ToolTip="{Binding Attributes}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger
                                                                Binding="{Binding IsAvailable}"
                                                                Value="False">
                                                                <Setter Property="Foreground" Value="PaleVioletRed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn
                                    Width="Auto"
                                    MinWidth="100"
                                    CanUserSort="True"
                                    Header="Created"
                                    IsReadOnly="True"
                                    SortMemberPath="Created">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                FontSize="{Binding ElementName=ZoomSlider, Path=Value}"
                                                Text="{Binding Created, Converter={ui:TimeConverter}}"
                                                TextAlignment="Center"
                                                ToolTip="{Binding Created}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger
                                                                Binding="{Binding IsAvailable}"
                                                                Value="False">
                                                                <Setter Property="Foreground" Value="PaleVioletRed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn
                                    Width="Auto"
                                    MinWidth="100"
                                    CanUserSort="True"
                                    Header="Last modified"
                                    IsReadOnly="True"
                                    SortMemberPath="LastModified">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                FontSize="{Binding ElementName=ZoomSlider, Path=Value}"
                                                Text="{Binding LastModified, Converter={ui:TimeConverter}}"
                                                TextAlignment="Center"
                                                ToolTip="{Binding LastModified}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger
                                                                Binding="{Binding IsAvailable}"
                                                                Value="False">
                                                                <Setter Property="Foreground" Value="PaleVioletRed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn
                                    Width="Auto"
                                    MinWidth="100"
                                    CanUserSort="True"
                                    Header="Added"
                                    IsReadOnly="True"
                                    SortMemberPath="Added">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                FontSize="{Binding ElementName=ZoomSlider, Path=Value}"
                                                Text="{Binding Added, Converter={ui:TimeConverter}}"
                                                TextAlignment="Center"
                                                ToolTip="{Binding Added}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger
                                                                Binding="{Binding IsAvailable}"
                                                                Value="False">
                                                                <Setter Property="Foreground" Value="PaleVioletRed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Fluent:StatusBar Grid.Row="1">
                            <Fluent:StatusBarItem
                                Title="Font size"
                                Width="300"
                                HorizontalAlignment="Left"
                                Value="{Binding ElementName=ZoomSlider, Path=Value}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Font size:" />
                                    <Slider
                                        x:Name="ZoomSlider"
                                        Width="200"
                                        IsSnapToTickEnabled="True"
                                        Maximum="22"
                                        Minimum="14"
                                        TickFrequency="1"
                                        ToolTip="{Binding ElementName=ZoomSlider, Path=Value}"
                                        Value="16" />
                                    <TextBlock Text="{Binding ElementName=ZoomSlider, Path=Value}" />
                                </StackPanel>
                            </Fluent:StatusBarItem>

                            <Separator HorizontalAlignment="Left" />

                            <Fluent:StatusBarItem
                                Title="Total File size"
                                HorizontalAlignment="Right"
                                Value="{Binding TotalSize}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Total size: " />
                                    <TextBlock Text="{Binding TotalSize}" />
                                </StackPanel>
                            </Fluent:StatusBarItem>

                            <Fluent:StatusBarItem
                                Title="File counter"
                                Margin="4,0"
                                HorizontalAlignment="Right"
                                Value="{Binding ElementName=DataGrid, Path=Items.Count}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Files: " />
                                    <TextBlock Text="{Binding ElementName=DataGrid, Path=Items.Count}" />
                                </StackPanel>
                            </Fluent:StatusBarItem>
                        </Fluent:StatusBar>
                    </Grid>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
    </Grid>
</Fluent:RibbonWindow>
