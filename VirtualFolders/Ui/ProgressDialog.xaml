<Window
    x:Class="VirtualFolders.Ui.ProgressDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:VirtualFolders.Ui"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="ProgressDialog"
    Width="720"
    MinHeight="200"
    Closing="Window_Closing"
    ResizeMode="CanMinimize"
    WindowStyle="SingleBorderWindow"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock
            Grid.Row="0"
            Margin="8"
            HorizontalAlignment="Center"
            Text="Total progress" />
        <ProgressBar
            x:Name="Total"
            Grid.Row="1"
            Height="30"
            Margin="8" />
        <TextBlock
            x:Name="TotalPercentText"
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Text="0%" />
        <TextBlock
            Grid.Row="2"
            Margin="8"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Text="Current file process" />
        <ProgressBar
            x:Name="Current"
            Grid.Row="3"
            Height="30"
            Margin="8" />
        <TextBlock
            x:Name="CurrentPercentText"
            Grid.Row="3"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Text="0%" />
        <Button
            Grid.Row="4"
            HorizontalAlignment="Right"
            Click="Button_Click"
            Content="Cancel"
            Style="{StaticResource DialogButton}" />
    </Grid>
</Window>
