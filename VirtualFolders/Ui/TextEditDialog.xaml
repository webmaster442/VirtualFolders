<Window
    x:Class="VirtualFolders.Ui.TextEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:VirtualFolders.Ui"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="TextEditDialog"
    Width="720"
    MinHeight="200"
    ResizeMode="CanMinimize"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox
            x:Name="TextEditor"
            Grid.Row="0"
            Grid.ColumnSpan="4"
            AcceptsReturn="True"
            AcceptsTab="True"
            FontSize="14"
            ScrollViewer.VerticalScrollBarVisibility="Visible"
            Text="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nam viverra, erat eu volutpat mattis, tortor urna ultricies tortor, sit amet ornare metus elit vel magna. Aliquam vel porta lorem. Etiam posuere libero a nisl molestie, sit amet hendrerit orci luctus. Proin varius lacus tellus. Aenean placerat fringilla enim. Suspendisse potenti. Vestibulum pulvinar quam nec tincidunt dignissim. Nam suscipit tempor dolor id mollis. Maecenas eget augue ut est malesuada pellentesque id non diam. Vestibulum volutpat odio eget malesuada varius.  Donec ultrices massa nunc, a tristique lacus tempus quis. Phasellus a hendrerit ligula, vel dignissim purus. Cras id nisl nec tellus tincidunt porttitor. Vivamus aliquet convallis velit, ac sodales ligula pulvinar non. Nullam gravida turpis sit amet aliquet tempor. Quisque non pellentesque nisi. Nullam porttitor justo eget auctor vestibulum. Cras congue eros rhoncus congue pellentesque. Etiam nec tellus nibh. Morbi volutpat, urna ut mattis porta, dui elit finibus ipsum, nec rutrum mi. "
            TextChanged="TextEditor_TextChanged"
            TextWrapping="Wrap" />
        <TextBlock
            x:Name="CharCounter"
            Grid.Row="1"
            Grid.Column="1"
            Margin="4"
            VerticalAlignment="Center"
            FontSize="14"
            Text="1000"
            TextAlignment="Right" />
        <Button
            Grid.Row="1"
            Grid.Column="2"
            Click="OkClick"
            Content="Ok"
            Style="{StaticResource DialogButton}" />
        <Button
            Grid.Row="1"
            Grid.Column="3"
            Click="CancelClick"
            Content="Cancel"
            Style="{StaticResource DialogButton}" />
    </Grid>
</Window>
