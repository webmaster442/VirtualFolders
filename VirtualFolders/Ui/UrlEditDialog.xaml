<Window
    x:Class="VirtualFolders.Ui.UrlEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:VirtualFolders.Ui"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="UrlEditDialog"
    Width="720"
    Height="155"
    ResizeMode="CanMinimize"
    Loaded="Window_Loaded"
    mc:Ignorable="d">
    <Grid ShowGridLines="False">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock
            Grid.Row="0"
            Grid.Column="0"
            Margin="4"
            Text="Url:" />
        <TextBox
            x:Name="TbUrl"
            Grid.Row="0"
            Grid.Column="1"
            Grid.ColumnSpan="2"
            Margin="4"
            VerticalAlignment="Center"
            FontSize="14"
            TextChanged="TbUrl_TextChanged" />
        <TextBlock
            Grid.Row="1"
            Grid.Column="0"
            Margin="4"
            VerticalAlignment="Center"
            Text="Name:" />
        <TextBox
            TextChanged="TbName_TextChanged"
            x:Name="TbName"
            Grid.Row="1"
            Grid.Column="1"
            Grid.ColumnSpan="2"
            Margin="4"
            FontSize="14" />
        <TextBlock
            x:Name="TbError"
            Grid.Row="2"
            Grid.Column="1"
            Margin="4"
            VerticalAlignment="Center"
            Foreground="Red"
            Text="" />
        <Button
            x:Name="BtnOk"
            Grid.Row="2"
            Grid.Column="1"
            HorizontalAlignment="Right"
            Click="OkClick"
            Content="Ok"
            Style="{StaticResource DialogButton}" />
        <Button
            Grid.Row="2"
            Grid.Column="3"
            Click="CancelClick"
            Content="Cancel"
            Style="{StaticResource DialogButton}" />
    </Grid>
</Window>
